+            const struct pl_reshape_data *comp = &data->comp[c];
+            if (!comp->num_pivots) { lut_ok = false; break; }
+            for (int i = 0; i < comp->num_pivots - 1; i++)
+                if (comp->method[i] != 0) { lut_ok = false; break; }
+            if (!lut_ok) break;
+        }
+        if (lut_ok && !getenv("B0B_DOVI_NO_LUT")) {
+            static float lut[3 * B0B_DOVI_LUT_N];
+            static float fine[3 * B0B_DOVI_LUT_FINE];
+            const bool diff = getenv("B0B_DOVI_LUT_DIFF") != NULL;
+            for (int c = 0; c < 3; c++) {
+                const struct pl_reshape_data *comp = &data->comp[c];
+                for (int i = 0; i < B0B_DOVI_LUT_N; i++) {
+                    float x = (float) i / (B0B_DOVI_LUT_N - 1);
+                    int seg = 0;
+                    for (int k = 0; k < comp->num_pivots - 1; k++)
+                        if (x >= comp->pivots[k]) seg = k;
+                    const float *cf = comp->poly_coeffs[seg];
+                    lut[c * B0B_DOVI_LUT_N + i] = (cf[2] * x + cf[1]) * x + cf[0];
+                }
