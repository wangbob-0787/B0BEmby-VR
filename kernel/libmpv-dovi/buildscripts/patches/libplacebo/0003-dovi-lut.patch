+            });
+            GLSL("// dovi LUT                          \n"
+                 "vec3 lutpos = clamp(color.rgb, 0.0, 1.0) * float(%d - 1); \n"
+                 "vec3 out_lut; \n"
+                 "for (int ch = 0; ch < 3; ch++) { \n"
+                 "    float p = lutpos[ch]; \n"
+                 "    float i0 = floor(p); \n"
+                 "    float f = p - i0; \n"
+                 "    int base = ch * %d; \n"
+                 "    int idx0 = base + int(i0); \n"
+                 "    int idx1 = min(idx0 + 1, base + %d - 1); \n"
+                 "    out_lut[ch] = mix("$"[idx0], "$"[idx1], f); \n"
+                 "} \n",
+                 B0B_DOVI_LUT_N, B0B_DOVI_LUT_N, B0B_DOVI_LUT_N, luts, luts);
