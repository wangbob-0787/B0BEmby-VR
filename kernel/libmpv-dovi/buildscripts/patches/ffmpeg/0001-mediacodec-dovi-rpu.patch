+/* Parse Dolby Vision RPU NALs in the packet, key by PTS, append to the
+ * FIFO. Only the LAST RPU in a packet defines the AU's state. */
+static void mediacodec_dovi_scan(AVCodecContext *avctx,
+                                 MediaCodecH264DecContext *s,
+                                 const AVPacket *pkt)
+{
+    int ret;
+    int flags = H2645_FLAG_SMALL_PADDING;
+    int nal_length_size = 0;
+    int64_t pts;
+    int off = 0, out = 0;
+
+    if (!s->hevc_dovi || pkt->size <= 4)
+        return;
+
+    /* 容器把杜比配置记录挂在码流或包上。解码器初始化时那份常常还没到
+     * （mpv 打开解码器的时机早于首包），于是解析器只能猜 profile，
+     * 猜错就把每帧元数据全判成非法。一旦包上带着它，立刻补进上下文。 */
+    if (!s->dovi_ctx.cfg.dv_profile) {
+        for (int i = 0; i < pkt->side_data_elems; i++) {
+            const AVPacketSideData *sd = &pkt->side_data[i];
+            if (sd->type != AV_PKT_DATA_DOVI_CONF ||
+                sd->size < sizeof(s->dovi_ctx.cfg))
+                continue;
+            s->dovi_ctx.cfg = *(AVDOVIDecoderConfigurationRecord *)sd->data;
+            av_log(avctx, AV_LOG_INFO,
+                   "dovi: conf from packet profile=%d level=%d rpu=%d el=%d bl=%d compat=%d comp=%d\n",
+                   s->dovi_ctx.cfg.dv_profile, s->dovi_ctx.cfg.dv_level,
+                   s->dovi_ctx.cfg.rpu_present_flag, s->dovi_ctx.cfg.el_present_flag,
+                   s->dovi_ctx.cfg.bl_present_flag,
+                   s->dovi_ctx.cfg.dv_bl_signal_compatibility_id,
+                   s->dovi_ctx.cfg.dv_md_compression);
+            break;
+        }
+    }
+
+    /* 判断是不是 4 字节长度前缀（mp4/mkv 走这条，annex-B 走另一条） */
+    /* 封装判定：4 字节长度前缀的首个长度必须落在包内。
+     * 之前按"整包刚好走完"判，包尾带几点填充就判错，每帧都靠事后重切兜底。 */
+    {
+        uint32_t len0 = pkt->size >= 4 ? AV_RB32(pkt->data) : 0;
+        if (len0 >= 4 && (size_t)len0 + 4 <= (size_t)pkt->size)
+            nal_length_size = 4;
+    }
+    if (nal_length_size != 4) {
+        av_fast_malloc(&s->dovi_join, &s->dovi_join_cap,
+                       pkt->size + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!s->dovi_join)
+            return;
+        memcpy(s->dovi_join, pkt->data, pkt->size);
+        out = pkt->size;
+    } else {
+        /* 跨包拼接：解码器收到的包有时把一帧切成几段，末尾的 RPU 被截断，
+         * 解析器就报非法（实测尾部标记对不上）。余料留到下一个包，拼成完整 NAL。 */
+        av_fast_malloc(&s->dovi_accum, &s->dovi_accum_cap,
+                       s->dovi_accum_len + pkt->size + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!s->dovi_accum)
+            return;
+        memcpy(s->dovi_accum + s->dovi_accum_len, pkt->data, pkt->size);
+        s->dovi_accum_len += pkt->size;
+
+        av_fast_malloc(&s->dovi_join, &s->dovi_join_cap,
+                       s->dovi_accum_len + AV_INPUT_BUFFER_PADDING_SIZE);
+        if (!s->dovi_join)
+            return;
+        while (off + 4 <= s->dovi_accum_len) {
+            uint32_t len = AV_RB32(s->dovi_accum + off);
+            if (!len || off + 4 + (int)len > s->dovi_accum_len)
+                break;
+            memcpy(s->dovi_join + out, s->dovi_accum + off, 4 + len);
+            out += 4 + (int)len;
+            off += 4 + (int)len;
+        }
+        if (off > 0) {
+            memmove(s->dovi_accum, s->dovi_accum + off, s->dovi_accum_len - off);
+            s->dovi_accum_len -= off;
+        }
+        if (out <= 0)
+            return;
+    }
+
+    if (s->dovi_fifo_len < 3)
+        av_log(avctx, AV_LOG_INFO, "dovi: scan pkt=%d out=%d nls=%d accum=%d\n",
+               pkt->size, out, nal_length_size, s->dovi_accum_len);
+
+    ff_h2645_packet_uninit(&s->dovi_pkt);
+    ret = ff_h2645_packet_split(&s->dovi_pkt, s->dovi_join, out, avctx,
+                                nal_length_size, AV_CODEC_ID_HEVC, flags);
+    if (ret < 0) {
+        ff_h2645_packet_uninit(&s->dovi_pkt);
+        return;
+    }
+
+    for (int i = s->dovi_pkt.nb_nals - 1; i >= 0; i--) {
+        H2645NAL *nal = &s->dovi_pkt.nals[i];
+
+        /* Dolby Vision RPUs masquerade as unregistered NALs of type 62 */
+        if (nal->type != 62 || nal->size <= 2 ||
+            nal->nuh_layer_id || nal->temporal_id)
+            continue;
+
+        ret = ff_dovi_rpu_parse(&s->dovi_ctx, nal->data + 2, nal->size - 2, 0);
+        if (ret < 0) {
+            /* 有的封装把 RPU 与后面的字节连成一段，长度比真实 RPU 长：
+             * 从后往前找合法的 0x80 结尾重切，能解析就采用。 */
+            for (int k = nal->size - 1; k > 3; k--) {
+                if (nal->data[k] != 0x80)
+                    continue;
+                if (ff_dovi_rpu_parse(&s->dovi_ctx, nal->data + 2, k - 1, 0) >= 0) {
+                    av_log(avctx, AV_LOG_INFO,
+                           "dovi: rpu re-cut end=%d size=%d raw=%d\n",
+                           k, nal->size, nal->raw_size);
+                    ret = 0;
+                    break;
+                }
+            }
+        }
+        if (ret < 0) {
+            av_log(avctx, AV_LOG_WARNING,
+                   "dovi: parse fail ret=%d pkt=%d nals=%d raw=%d size=%d hdr=%02x%02x%02x%02x"
+                   " tail=%02x%02x\n",
+                   ret, pkt->size, s->dovi_pkt.nb_nals, nal->raw_size, nal->size,
+                   nal->data[0], nal->data[1], nal->data[2], nal->data[3],
+                   nal->data[nal->size > 1 ? nal->size - 2 : 0],
+                   nal->data[nal->size ? nal->size - 1 : 0]);
+            break;
+        }
+
+        {
+            AVDOVIMetadata *md = NULL;
+            int md_size = ff_dovi_get_metadata(&s->dovi_ctx, &md);
+            if (md_size <= 0) {
+                if (md)
+                    av_free(md);
+                break;
+            }
+            if (s->dovi_fifo_len == MEDIACODEC_DOVI_FIFO_MAX) {
+                av_free(s->dovi_fifo[0].md);
+                memmove(&s->dovi_fifo[0], &s->dovi_fifo[1],
+                        (MEDIACODEC_DOVI_FIFO_MAX - 1) * sizeof(s->dovi_fifo[0]));
+                s->dovi_fifo_len--;
+            }
+            pts = pkt->pts != AV_NOPTS_VALUE ? pkt->pts : pkt->dts;
+            s->dovi_fifo[s->dovi_fifo_len] = (MediaCodecDoviRpuEntry) {
+                pts, md, md_size
+            };
+            s->dovi_fifo_len++;
+
+            /* Keep one representative RPU and reuse it for every frame.
+             * The per-frame RPU curves in real P5 content differ enough
+             * that following them frame by frame makes the whole picture
+             * "breathe" (visible as warm/cool and dark/bright pumping),
+             * because the mapping applied per frame does not line up with
+             * the reordered hardware-decoder output. Freezing after the
+             * first few AUs gives one stable, correct mapping. */
+            if (s->dovi_seen < MEDIACODEC_DOVI_FREEZE_AFTER) {
+                void *copy = av_malloc(md_size);
+                if (copy) {
+                    memcpy(copy, md, md_size);
+                    av_freep(&s->dovi_frozen);
+                    s->dovi_frozen = copy;
+                    s->dovi_frozen_size = md_size;
+                }
+            }
+            s->dovi_seen++;
+
+            break; /* one RPU per AU */
+        }
+    }
+
+    ff_h2645_packet_uninit(&s->dovi_pkt);
+}
+
+/* Attach the RPU state to the frame: the newest RPU not newer than the
+ * frame's PTS (inherit semantics). Never consume matched entries. */
+static void mediacodec_dovi_attach(AVCodecContext *avctx,
+                                   MediaCodecH264DecContext *s,
+                                   AVFrame *frame)
+{
+    AVBufferRef *buf;
+    MediaCodecDoviRpuEntry *e = NULL;
+    AVDOVIMetadata *m, *fz;
+    int64_t pts = frame->pts;
+    int i;
+
+    if (!s->hevc_dovi || !s->dovi_frozen || s->dovi_frozen_size <= 0)
+        return; /* cold start: no RPU parsed yet */
+
+    if (pts != AV_NOPTS_VALUE) {
+        for (i = 0; i < s->dovi_fifo_len; i++) {
+            int64_t p = s->dovi_fifo[i].pts;
+            if (p == AV_NOPTS_VALUE)
+                continue;
+            if (p <= pts && (!e || p > e->pts))
+                e = &s->dovi_fifo[i];
+        }
+    }
+    if (!e && s->dovi_fifo_len)
+        e = &s->dovi_fifo[0];
+
+    if (!e) {
+        buf = av_buffer_alloc(s->dovi_frozen_size);
+        if (!buf)
+            return;
+        memcpy(buf->data, s->dovi_frozen, s->dovi_frozen_size);
+        av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_METADATA, buf);
+        return;
+    }
+
+    buf = av_buffer_alloc(e->size);
+    if (!buf)
+        return;
+    memcpy(buf->data, e->md, e->size);
+
+    m  = (AVDOVIMetadata *)buf->data;
+    fz = (AVDOVIMetadata *)s->dovi_frozen;
+    if (m->ext_block_offset > m->color_offset &&
+        fz->ext_block_offset > fz->color_offset &&
+        (m->ext_block_offset - m->color_offset) ==
+        (fz->ext_block_offset - fz->color_offset)) {
+        memcpy((uint8_t *)m + m->color_offset,
+               (uint8_t *)fz + fz->color_offset,
+               fz->ext_block_offset - fz->color_offset);
+    }
+    if (m->num_ext_blocks > 0 && fz->num_ext_blocks > 0 &&
+        m->ext_block_size == fz->ext_block_size) {
+        int n = FFMIN(m->num_ext_blocks, fz->num_ext_blocks);
+        memcpy((uint8_t *)m + m->ext_block_offset,
+               (uint8_t *)fz + fz->ext_block_offset,
+               (size_t)n * fz->ext_block_size);
+        m->num_ext_blocks = n;
+    }
+
+    av_frame_new_side_data_from_buf(frame, AV_FRAME_DATA_DOVI_METADATA, buf);
+    mediacodec_dovi_publish((const AVDOVIMetadata *)e->md);
+
+    if (pts != AV_NOPTS_VALUE && e->pts != AV_NOPTS_VALUE) {
+        int64_t d = pts - e->pts;
+        if (d < s->dovi_diag_min)
+            s->dovi_diag_min = d;
+        if (d > s->dovi_diag_max)
+            s->dovi_diag_max = d;
+    }
+    s->dovi_diag_frames++;
+    if (s->dovi_diag_frames >= 120) {
+        int l1_avg = -1, l1_max = -1;
+        for (i = 0; i < m->num_ext_blocks; i++) {
+            AVDOVIDmData *ext = av_dovi_get_ext(m, i);
+            if (ext->level == 1) {
+                l1_avg = ext->l1.avg_pq;
+                l1_max = ext->l1.max_pq;
+                break;
+            }
+        }
+        av_log(avctx, AV_LOG_INFO,
+               "dovi-diag: frames=%d fifo=%d pts_delta=[%lld..%lld] ext=%d/%d l1_avg=%d l1_max=%d\n",
+               s->dovi_diag_frames, s->dovi_fifo_len,
+               (long long)s->dovi_diag_min, (long long)s->dovi_diag_max,
+               m->num_ext_blocks, fz->num_ext_blocks, l1_avg, l1_max);
+        s->dovi_diag_frames = 0;
+        s->dovi_diag_min = INT64_MAX;
+        s->dovi_diag_max = INT64_MIN;
+    }
+}
