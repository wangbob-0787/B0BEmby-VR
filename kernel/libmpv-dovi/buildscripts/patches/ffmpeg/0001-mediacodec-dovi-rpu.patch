+static av_cold int mediacodec_dovi_init(AVCodecContext *avctx,
+                                        MediaCodecH264DecContext *s)
+{
+    const AVPacketSideData *sd;
+
+    ff_h2645_packet_uninit(&s->dovi_pkt);
+    ff_dovi_ctx_unref(&s->dovi_ctx);
+    s->dovi_ctx.logctx = avctx;
+
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_DOVI_CONF);
+    if (sd && sd->size >= sizeof(s->dovi_ctx.cfg))
+        s->dovi_ctx.cfg = *(AVDOVIDecoderConfigurationRecord *)sd->data;
+
+    s->hevc_dovi = 1;
+    s->dovi_fifo_len = 0;
+    s->dovi_diag_frames = 0;
+    s->dovi_diag_min = INT64_MAX;
+    s->dovi_diag_max = INT64_MIN;
+
+    if (!s->dovi_ctx.cfg.dv_profile)
+        av_log(avctx, AV_LOG_WARNING, "dovi: no DOVI configuration record in coded side data; parsing with guessed profile\n");
+    return 0;
+}
