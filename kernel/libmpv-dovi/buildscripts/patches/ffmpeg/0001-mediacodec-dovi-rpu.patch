+/* ------------------------- Dolby Vision RPU injection ------------------ */
+
+/* 把一帧的映射参数按约定拍平成 float 数组（布局见 docs/4xvr-reverse §7）。
+ * 换算照 libplacebo 的 av_dovi -> pl_dovi：分段点除以位深满值，
+ * 多项式系数除以 2^coef_log2_denom。 */
+static void mediacodec_dovi_publish(const AVDOVIMetadata *md)
+{
+    const AVDOVIRpuDataHeader *hdr;
+    const AVDOVIDataMapping *map;
+    int n = 3;
+
+    if (!md)
+        return;
+    hdr = av_dovi_get_header(md);
+    map = av_dovi_get_mapping(md);
+
+    b0b_dovi_flat[0] = 1.0f;                 /* 版本 */
+    b0b_dovi_flat[1] = 3.0f;                 /* 通道数 */
+    for (int c = 0; c < 3; c++) {
+        const AVDOVIReshapingCurve *cur = &map->curves[c];
+        const float pscale = 1.0f / ((1 << hdr->bl_bit_depth) - 1);
+        const float cscale = 1.0f / (1 << hdr->coef_log2_denom);
+        int piv = cur->num_pivots;
+
+        if (piv < 1) piv = 1;
+        if (piv > 9) piv = 9;
+        b0b_dovi_flat[n++] = (float) piv;
+        for (int k = 0; k < 8; k++)
+            b0b_dovi_flat[n++] = k < piv ? pscale * cur->pivots[k] : 0.0f;
+        for (int k = 0; k < 8; k++) {
+            int poly = k < piv - 1 && cur->mapping_idc[k] == AV_DOVI_MAPPING_POLYNOMIAL;
+            for (int j = 0; j < 3; j++)
+                b0b_dovi_flat[n++] = poly && j <= cur->poly_order[k]
+                                         ? cscale * (float) cur->poly_coef[k][j]
+                                         : 0.0f;
+        }
+    }
+    b0b_dovi_seq++;
+    b0b_dovi_ready = 1;
+}
