{
  "manifest_version": 2,
  "name": "b0b-bridge",
  "version": "1.7",
  "description": "把网页里正在播的视频画面位置与真实播放地址交回 B0BEmby VR 客户端（父亲 2026-10-15）",
  "browser_specific_settings": {
    "gecko": {
      "id": "b0b-bridge@local",
      "strict_min_version": "100.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "cookies"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.v.qq.com/*",
        "*://*.qq.com/*",
        "*://*.iqiyi.com/*"
      ],
      "js": [
        "isolated.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.v.qq.com/*",
        "*://*.qq.com/*",
        "*://*.iqiyi.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
