<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      面板层（VirtualDisplay + Presentation）在 PICO 上要求 WAKE_LOCK：
      缺少时 createVirtualDisplay 抛
      SecurityException: Neither user ... has android.permission.WAKE_LOCK
      → 某些面板层建不起来（菜单会打不开），见 2026-10-07 实测日志。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 应用内更新：下载完要交给系统安装器，没有这条权限 startActivity 会被拒 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      VR 头显能力声明。

      注意 `required`：`android.hardware.vr.headtracking` 若写 required="true"，
      PICO 会把应用归入 VR 应用并走 VR 合成器路径。当前阶段（最小平面虚拟屏）
      我们要的是「头显里看到一块平面屏」，走 PICO 的 2D 面板模式更稳，因此
      这里保留声明但**不强制**，由系统按应用类型决定呈现方式。
    -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vr.high_performance"
        android:required="false" />
    <!--
      【重要】不声明 android.hardware.touchscreen（2026-10-04 实测结论）。

      对照实验：哔哩哔哩 TV 版（tv.danmaku.bilibilihd）的 manifest 里
      **完全没有** touchscreen 声明，它在 PICO 上能拿到独立摇杆信号
      （晃动零反应、拨摇杆持续快进、A 键菜单、B 键返回）；
      而我们声明了 required=false，PICO 只给我们「光标模拟」——
      手柄全部输入被压成触摸坐标，拿不到摇杆与按键。

      推断：PICO 见到应用声明 touchscreen 就按「触摸应用」处理，
      给虚拟光标；不声明则按 TV/手柄应用处理，发方向键与摇杆。
      去掉此声明以便实测验证（原声明历史见 git）。
    -->

    <!--
      usesCleartextTraffic：允许 http:// 明文请求（关键，别删）。

      Android 9（API 28）起默认禁止明文 HTTP，未声明时所有 http 请求
      会被系统直接拒绝 —— 表现是应用内「网络错误」，而服务端日志里
      一条访问记录都没有，极易误判成网络不通。
      Emby 内网地址是 `http://192.168.150.15:6908`（明文端口），必须放开。
      TV 版 B0BEmby 同样声明了这一项（见其 AndroidManifest.xml line 32）。
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />

                <!--
                  PICO 的 VR 应用分类声明（2026-10-12 加回，父亲按 A 方案批准）。

                  起因：父亲回忆「最开始开发 VR 版时 PICO 是识别这个应用的，后来
                  某一版才变成未知来源」。核对清单历史证实了这个回忆：

                    · fa56e85（10-03 19:46，build-1）= `pvr.app.type` + 本分类声明
                      **两条都在** → 这一版 PICO 认可（父亲实测）
                    · 45de711（10-03 21:35，修全黑）把**两条一起删掉** → 识别丢失
                    · 788718b（10-05）只补回 `pvr.app.type`，**本分类声明没补**
                    · 21f88e6（10-06 20:16）补回本声明 → 2034043（10-06 20:52）又撤回
                      → 至今一直是缺这条声明的形态，也就一直待在「未知来源」

                  对 10-06 那次「加了反而被归回未知来源」的结论存疑：PICO 的分类是
                  **安装时读一次**，当时只是覆盖安装，本来就测不出效果；而且刚删掉的
                  瞬间分类也不会自己变。现在按 build-1 的原始形态把两条声明都恢复。

                  ⚠️ 生效前提：必须**卸载后重装**，覆盖安装不算数。
                -->
                <category android:name="com.pico.intent.category.VR" />
            </intent-filter>

            <!--
              2026-10-12 晚恢复：这一条是「PICO 按 VR 应用对待我们」的开关，
              删了它 PICO 会把应用当 2D 应用启动（黑屏 + 手柄失灵，详见下方实测记录）。
            -->
            <meta-data
                android:name="pvr.app.type"
                android:value="vr" />

            <!--
              ============ 「未知来源」分类的判据已定案（2026-10-12 对照实验）============

              父亲的诉求：PICO 资源库把我们这个自用客户端一直归到「未知来源」。

              逐步排除（每条都是实测，别再重走）：
                · 不是安装来源 ——「沙发管家」（com.shafa.market）的 installer 与我们
                  同为 com.android.packageinstaller，它却不在「未知来源」。
                · 不是包名 —— 实验版换成 com.xxxx.emby_vr.exp 依旧被正确识别。
                · 不是 PICO 商店清单 —— 父亲在头显商店里搜「沙发管家」搜不到。
                · 不是缺 LAUNCHER 标签 —— 我们一直有 LAUNCHER + LEANBACK_LAUNCHER。
                · 不是版本号缓存 —— 修好版本号（run 464）后分类没变。

              判定性实验：把 `pvr.app.type` 这一条**只删这一条**、其余不动，
              用独立包名（com.xxxx.emby_vr.exp）编了一版装上去 ——
              结果它出现在资源库的「应用」分类里，且能正常显示登录页。
              → **分类开关就是 `pvr.app.type=vr`**：声明了它，PICO 认为这是
              「VR 应用」，而 VR 应用没有商店记录就一律进「未知来源」；不声明则
              按普通 2D 应用对待，进「应用」。

              佐证（从设备里挖出来的，不是猜的）：
                · 资源库 com.pvr.appmanager（/system/priv-app/AppManager）的 dex 里有
                  FILTER_IS_VR / TAB_APP / TAB_GAME / TAB_UNKNOWN 常量、资源名
                  main_menu_unknown_source，并且**读的就是 `pvr.app.type`**。
                · 该系统提示原文：「您正在尝试运行的应用属于未知来源应用。请登录
                  开发者账号进行对应操作。」—— 未知来源这套是给开发者调试用的。
                · 官方文档 developer-cn.picoxr.com/document/unity/
                  installed-app-not-showing/：未上架 PICO 商店的应用显示在
                  「未知来源」条目下，已上架的才显示在对应分类下。

              ❌ **代价已实测，结论：加回去（2026-10-12 晚，run 473）**。
              去掉 `pvr.app.type` 后 PICO 就不再把我们当 VR 应用，而是当成
              **2D 应用**，启动时给它套一个 2D 面板壳：

                · `dumpsys display` 里冒出 `NS_APP[com.xxxx.emby_vr]`（1602x902）
                  与 `NS_CAPTION_BAR_[B0BEmby VR]` —— 与哔哩哔哩 HD 那种 2D 应用
                  同一个形态；
                · 系统 AppList 里 `isvr=false`（Shortcut: AppListAdapter 日志）；
                · 父亲实测：眼前一块**黑屏**（2D 面板是空的，我们的画面只在 XR
                  会话里提交），而且**控制条扣扳机唤不出来** —— 手柄事件被 2D 面板
                  壳收走，没进 OpenXR。

              也就是说「在资源库里出现在『应用』分类」的代价是**整个应用不能以
              VR 形态正常用**，远大于分类带来的观感问题。所以这一版把它加回来，
              「未知来源」分类维持原样（那是给开发者调试用的归类，不影响使用）。

              历史对照（pvr.app.type 的来龙去脉，别丢）：
                · build-6/build-7 声明它 → 全黑。当时原因是**没接 VR 运行时**：
                  PICO 按 VR 应用合成后应用必须自己通过 OpenXR 提交立体帧，
                  而那时是单眼普通投影，什么都没提交 → 黑屏。
                · 45de711（10-03 21:35）删掉它 + 删掉 VR category → 走 2D 面板
                  （PICO 会为 2D 应用建 `NS_APP[<包名>]` 虚拟显示器，
                  `dumpsys display` 可见，哔哩哔哩 HD 就是这个形态）。
                · 788718b（10-05）接了官方 OpenXR（app/src/main/cpp/
                  openxr_renderer.cpp）后加回它，由原生线程提交立体帧。
            -->

        </activity>

        <!--
          应用内更新（父亲 2026-10-26 定：只做「检查更新」，点版本号才更新）。
          安装包放在 cacheDir/update 下，交给系统安装器时必须走 FileProvider —
          Android 7 起 file:// 直接抛 FileUriExposedException。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          装完之后系统会发 MY_PACKAGE_REPLACED。老进程在装包那一刻已被系统结束，
          这条广播是新版本自己收到 —— 用它把界面重新拉起来，用户不必去桌面找。
        -->
        <receiver
            android:name=".update.UpdateInstalledReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
