<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      VR 头显能力声明。

      注意 `required`：`android.hardware.vr.headtracking` 若写 required="true"，
      PICO 会把应用归入 VR 应用并走 VR 合成器路径。当前阶段（最小平面虚拟屏）
      我们要的是「头显里看到一块平面屏」，走 PICO 的 2D 面板模式更稳，因此
      这里保留声明但**不强制**，由系统按应用类型决定呈现方式。
    -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vr.high_performance"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      usesCleartextTraffic：允许 http:// 明文请求（关键，别删）。

      Android 9（API 28）起默认禁止明文 HTTP，未声明时所有 http 请求
      会被系统直接拒绝 —— 表现是应用内「网络错误」，而服务端日志里
      一条访问记录都没有，极易误判成网络不通。
      Emby 内网地址是 `http://192.168.150.15:6908`（明文端口），必须放开。
      TV 版 B0BEmby 同样声明了这一项（见其 AndroidManifest.xml line 32）。
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
              关于 `pvr.app.type=vr`（2026-10-03 实机结论，重要）：

              build-6/build-7 声明了它，结果 PICO 按 **VR 应用**合成 ——
              画面直出到 4320x2160 面板，不走「2D 面板虚拟显示器」路径，
              而我们的渲染是单眼 + 普通透视投影，与 VR 合成器要求不匹配，
              表现为**全黑**（实测截图中心像素 RGB 全 0）。

              「最小可用平面虚拟屏」阶段的目标是：头显里看到一块平面屏、
              手柄能操作。这用 **PICO 的 2D 面板模式**即可达成：
              PICO 会为 2D 应用建一个名为 `NS_APP[<包名>]` 的虚拟显示器
              （`dumpsys display` 可见，哔哩哔哩 HD 就是这个形态），
              应用照常在面板分辨率上输出，系统负责贴成空间面板。

              因此当前**不加** pvr.app.type，先走 2D 面板；
              等做真双目立体渲染（接 OpenXR runtime）时再加回来。
              对照：设备上的 4XVR Player 是原生 VR 播放器，
              它的 manifest 里 pvr.app.type 挂在 activity 上。
            -->

        </activity>
    </application>

</manifest>
