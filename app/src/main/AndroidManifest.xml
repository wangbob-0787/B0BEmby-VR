<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      面板层（VirtualDisplay + Presentation）在 PICO 上要求 WAKE_LOCK：
      缺少时 createVirtualDisplay 抛
      SecurityException: Neither user ... has android.permission.WAKE_LOCK
      → 某些面板层建不起来（菜单会打不开），见 2026-10-07 实测日志。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      VR 头显能力声明。

      注意 `required`：`android.hardware.vr.headtracking` 若写 required="true"，
      PICO 会把应用归入 VR 应用并走 VR 合成器路径。当前阶段（最小平面虚拟屏）
      我们要的是「头显里看到一块平面屏」，走 PICO 的 2D 面板模式更稳，因此
      这里保留声明但**不强制**，由系统按应用类型决定呈现方式。
    -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vr.high_performance"
        android:required="false" />
    <!--
      【重要】不声明 android.hardware.touchscreen（2026-10-04 实测结论）。

      对照实验：哔哩哔哩 TV 版（tv.danmaku.bilibilihd）的 manifest 里
      **完全没有** touchscreen 声明，它在 PICO 上能拿到独立摇杆信号
      （晃动零反应、拨摇杆持续快进、A 键菜单、B 键返回）；
      而我们声明了 required=false，PICO 只给我们「光标模拟」——
      手柄全部输入被压成触摸坐标，拿不到摇杆与按键。

      推断：PICO 见到应用声明 touchscreen 就按「触摸应用」处理，
      给虚拟光标；不声明则按 TV/手柄应用处理，发方向键与摇杆。
      去掉此声明以便实测验证（原声明历史见 git）。
    -->

    <!--
      usesCleartextTraffic：允许 http:// 明文请求（关键，别删）。

      Android 9（API 28）起默认禁止明文 HTTP，未声明时所有 http 请求
      会被系统直接拒绝 —— 表现是应用内「网络错误」，而服务端日志里
      一条访问记录都没有，极易误判成网络不通。
      Emby 内网地址是 `http://192.168.150.15:6908`（明文端口），必须放开。
      TV 版 B0BEmby 同样声明了这一项（见其 AndroidManifest.xml line 32）。
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />

                <!--
                  【不要加 com.pico.intent.category.VR】2026-10-06 晚实测撤回。

                  背景：2026-10-05 加上 activity 上的 pvr.app.type=vr 之后，
                  PICO 按 VR 应用认可了本应用（父亲实测）；2026-10-06 晚我又加了
                  一条 PICO 分类声明，随后 PICO 又把它归回「未知来源」。
                  清单里唯一的差异就是这一条，因此撤回，恢复 10-05 被认可的形态。
                  PICO 认 VR 应用靠的是 activity 上的 pvr.app.type，不是 intent category。
                -->
            </intent-filter>

            <!--
              VR 应用声明（2026-10-05 重新加回）。

              历史：build-6/build-7 加过它 → 全黑。当时的原因是**没有接 VR 运行时**：
             PICO 按 VR 应用合成后，应用必须自己通过 OpenXR 提交立体帧，
             而那时我们还是单眼普通投影，所以什么都没提交 → 黑屏。

              现在已接入官方 OpenXR（app/src/main/cpp/openxr_renderer.cpp），
              由原生线程提交立体帧，因此按 VR 应用走才是对的：
              这样才能拿原始手柄输入（⭕/A/B 键、摇杆轴值），
              也才能把视频/字幕/弹幕/控制条画成各自独立的 VR 图层。
            -->
            <meta-data
                android:name="pvr.app.type"
                android:value="vr" />

            <!--
              关于 `pvr.app.type=vr`（2026-10-03 实机结论，重要）：

              build-6/build-7 声明了它，结果 PICO 按 **VR 应用**合成 ——
              画面直出到 4320x2160 面板，不走「2D 面板虚拟显示器」路径，
              而我们的渲染是单眼 + 普通透视投影，与 VR 合成器要求不匹配，
              表现为**全黑**（实测截图中心像素 RGB 全 0）。

              「最小可用平面虚拟屏」阶段的目标是：头显里看到一块平面屏、
              手柄能操作。这用 **PICO 的 2D 面板模式**即可达成：
              PICO 会为 2D 应用建一个名为 `NS_APP[<包名>]` 的虚拟显示器
              （`dumpsys display` 可见，哔哩哔哩 HD 就是这个形态），
              应用照常在面板分辨率上输出，系统负责贴成空间面板。

              因此当前**不加** pvr.app.type，先走 2D 面板；
              等做真双目立体渲染（接 OpenXR runtime）时再加回来。
              对照：设备上的 4XVR Player 是原生 VR 播放器，
              它的 manifest 里 pvr.app.type 挂在 activity 上。
            -->

        </activity>
    </application>

</manifest>
